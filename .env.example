# ==============================================================================
# RegulSense AI Regulatory Compliance Assistant - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this template to '.env':
#    - Windows: Copy-Item .env.example .env
#    - Linux/macOS: cp .env.example .env
# 2. Never commit your '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Embeddings Model Provider Configuration
# ------------------------------------------------------------------------------
# OPTION A: Local Ollama Deployment (Default - Zero API cost, fully offline)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
CHAT_MODEL=llama3:latest
EMBEDDING_MODEL=all-minilm

# OPTION B: Cloud OpenAI API (Uncomment to use official OpenAI endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-actual-api-key-here
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Service Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=production

# ------------------------------------------------------------------------------
# 3. ChromaDB Vector Storage Configuration
# ------------------------------------------------------------------------------
# Relative path to persistent Chroma vector index database
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=regulsense_regulatory_chunks

# ------------------------------------------------------------------------------
# 4. RAG Retrieval & Guardrail Parameters
# ------------------------------------------------------------------------------
# Default number of regulatory chunks retrieved per query
DEFAULT_TOP_K=3

# Minimum cosine similarity threshold (0.0 - 1.0) required to answer query
# Queries with top score below this threshold trigger safe guardrail refusal
MIN_SIMILARITY_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# 5. Document Upload & Storage Settings
# ------------------------------------------------------------------------------
# Local server directory where uploaded circulars (.pdf, .txt, .md) are saved
UPLOAD_DIRECTORY=data/uploads

# Maximum allowed file upload size in bytes (Default: 10 MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 6. Streamlit Frontend Client Configuration
# ------------------------------------------------------------------------------
# Base URL for the frontend UI to communicate with the FastAPI backend
REGULSENSE_API_URL=http://localhost:8000